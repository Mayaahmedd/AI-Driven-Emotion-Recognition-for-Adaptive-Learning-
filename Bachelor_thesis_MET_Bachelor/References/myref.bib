@misc{olukola_pedagogical_2026,
	title = {Pedagogical Safety in Educational Reinforcement Learning: Formalizing and Detecting Reward Hacking in {AI} Tutoring Systems},
	url = {http://arxiv.org/abs/2604.04237},
	doi = {10.48550/arXiv.2604.04237},
	abstract = {Reinforcement learning (RL) is increasingly applied to intelligent tutoring systems (ITSs), yet the field lacks a formal framework for defining and evaluating pedagogical safety. We address this gap by formalizing pedagogical safety as a set of constraints on RL tutoring policies, introducing the Reward Hacking Severity Index (RHSI) to quantify misalignment between proxy rewards and true learning objectives, and demonstrating through simulation that engagement-optimized policies can achieve high measured reward while producing negligible learning gains. Architectural safety constraints reduce RHSI from 0.317 to 0.102 compared to multi-objective reward shaping alone.},
	urldate = {2026-06-03},
	publisher = {arXiv},
	author = {Olukola, Oluseyi and Rahimi, Nick},
	month = apr,
	year = {2026},
	note = {arXiv:2604.04237 [cs.AI]},
}

