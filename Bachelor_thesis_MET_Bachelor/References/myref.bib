@article{septiana_emotion-related_2024,
	title = {Emotion-{Related} {Pedagogical} {Agent}: {A} {Systematic} {Literature} {Review}},
	volume = {12},
	issn = {2169-3536},
	shorttitle = {Emotion-{Related} {Pedagogical} {Agent}},
	url = {https://ieeexplore.ieee.org/document/10462142/},
	doi = {10.1109/ACCESS.2024.3374376},
	abstract = {Pedagogical agent is a software agent that provides guidance, feedback, or intervention to learners in digital environments. It has the potential to address issues in computer-based learning, particularly online learning, which often neglects affective aspects, such as the emotions of its users. Most systematic literature reviews (SLR) on pedagogical agent have focused on their visual design, types of feedback, and other empirical elements. However, what underlies these agents’ ability to provide interventions personalized to learner’s emotions has not been examined. So, this SLR explores how pedagogical agent has addressed learner’s emotional needs. The study’s research questions include: 1) To what extent does research exist on models, frameworks, or architectures for pedagogical agent, especially those related to emotions? 2) How are pedagogical agent represented, what types of interventions do they use, and how do they affect learner’s emotions? 3) What kinds of inputs are used to activate the pedagogical agent’s functions? This SLR applied the Kitchenham method to select reference sources from 2013 to 2023 and was indexed by Scopus in the Q1 to Q4 range. Our review revealed the absence of a specific model for mapping out interventions tailored to the learner’s emotional needs. Most existing pedagogical agent provide learning interventions that are less adaptive and personalized based on the learner’s emotional state and are applied to asynchronous learning systems such as e-learning. There are still very few pedagogical agents that use real-time input technology by utilizing artificial intelligence to recognize learner’s emotion to trigger an adaptive and personalized intervention.},
	urldate = {2026-03-15},
	journal = {IEEE Access},
	author = {Septiana, Asyifa Imanda and Mutijarsa, Kusprasapta and Putro, Budi Laksono and Rosmansyah, Yusep},
	year = {2024},
	keywords = {Emotion recognition, Adaptation models, Bibliographies, Chatbots, education, Electronic learning, emotion, Games, learner, learning intervention, Pedagogical agent, Reviews, Scientific publishing, Software agents, Systematics},
	pages = {36645--36656},
	annote = {adaptivE vipPaper Summary
Title: Emotion-Related Pedagogical Agent: A Systematic Literature Review Authors: Septiana, Mutijarsa, Putro \& Rosmansyah Year: 2024 Journal: IEEE Access — Volume 12 DOI: 10.1109/ACCESS.2024.3374376 Institution: Bandung Institute of Technology \& Indonesia University of Education

What the Paper Does
This is a systematic literature review (SLR) of 46 Scopus-indexed studies (Q1–Q4) examining how pedagogical agents — software agents that provide guidance, feedback, or intervention to learners in digital environments — have addressed learner emotional needs. Using the Kitchenham protocol, it covers the period 2013–2023 and investigates what models and frameworks exist for emotion-aware pedagogical agents, what types of interventions they deliver, and what inputs trigger those interventions. The paper's most significant finding is a confirmed research gap: no existing pedagogical agent works based on real-time learner emotional input using AI-based emotion recognition, and no model specifically maps interventions to a learner's detected emotional state.

What It Covers
1. Models and Frameworks for Emotion-Based Pedagogical Agents (RQ1)
Only seven of the 46 papers discuss any model or framework for pedagogical agents. These include the Extended ARCS model for 3D collaborative games, cognitive-affective models for instructional video, an empathic-pedagogical agent architecture for 3D virtual environments, and chatbot dialogue management models. Crucially, none of these models are grounded in widely recognized emotion theories (basic emotions, continuous emotions, or academic emotions). The emotions targeted are what designers expect learners to feel after the intervention — not the learner's actual initial emotional state. No model specifically links detected learner emotion to a tailored real-time intervention.
2. Representation, Interventions, and Emotional Impact (RQ2)
The review categorizes pedagogical agents across nine variables. Key findings include:


Role: Most agents serve as tutors (authoritative), followed by motivators. Very few act as peers or co-learners.


Interventions: Predominantly text-based — learning material delivery, guidance, motivational encouragement, hints, and question-answer dialogue. Affective interventions are divided into verbal (encouragement, motivation, anxiety management) and non-verbal (facial expressions, gestures, body language).


Learning environment: The overwhelming majority are deployed in asynchronous settings — e-learning platforms, video lectures, serious games, and chatbots. Only three sources use synchronous environments.


Emotional output from agents: 16 papers feature agents that express emotions (happiness, sadness, enthusiasm, sympathy, anger) to influence the learner — but this is one-directional. The agent expresses emotion; it does not detect the learner's emotion.


Critical finding: Not a single reviewed pedagogical agent operates based on real-time detection of the learner's emotional state. Agents express emotions toward learners; they do not respond to detected learner emotions.


3. Inputs That Trigger Pedagogical Agent Functions (RQ3)
The most common input types are the learner's test/work results and menu selections by the learner. Chatbot interaction and speech recognition are less frequent. Facial expression-based emotion recognition appears in only one source, and even there it is not used as a real-time trigger for adaptive intervention. Most agents rely on simple conditional programming rather than AI. Only 10 of the 46 papers explicitly mention any AI technology — predominantly NLP for chatbot agents.
4. Research Opportunities Identified
The paper concludes with an explicit call for exactly the kind of system your thesis proposes: a pedagogical agent that uses real-time AI-based emotion recognition from facial features to trigger adaptive, personalized learning interventions. It states directly that this represents an enormous and underexplored research opportunity, particularly for synchronous online learning environments.

