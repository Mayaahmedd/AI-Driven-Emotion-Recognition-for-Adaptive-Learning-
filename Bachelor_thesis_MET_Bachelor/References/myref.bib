	file = {Full Text PDF:/Users/mayoy/Zotero/storage/6EAYATMA/Islam et al. - 2021 - PAKES A Reinforcement Learning-Based Personalized Adaptability Knowledge Extraction Strategy for Ad.pdf:application/pdf},
