	journal = {Mind, Brain, and Education},
	author = {Immordino-Yang, Mary Helen and Damasio, Antonio},
	year = {2007},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/j.1751-228X.2007.00004.x},
	pages = {3--10},
	annote = {reference only
},
