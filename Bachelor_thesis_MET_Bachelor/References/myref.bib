@article{supriyadi_deepcrit_2026,
	title = {{DeepCrit}: {A} {Deep} {Learning}–{Driven} {Intelligent} {Tutoring} {System} to {Enhance} {Critical} {Action} {Skills} in {Science} {Learning}},
