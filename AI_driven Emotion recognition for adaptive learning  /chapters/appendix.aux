\@writefile{toc}{\contentsline {chapter}{\numberline {A}DQN Policy Replay Samples}{102}{appendix.A}\protected@file@percent }
\@writefile{lof}{\addvspace {10\p@ }}
\@writefile{lot}{\addvspace {10\p@ }}
\newlabel{app:replay}{{A}{102}{DQN Policy Replay Samples}{appendix.A}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.1}{\ignorespaces Episode 2, Step 3, cumulative reward $0.24$, with student state Knowledge $0.50$, Engagement $0.61$, Frustration $0.11$, Confusion $0.09$, Boredom $0.06$. The policy selected \textbf  {scaffold}, a flow-consistent choice that structures a high-engagement learner without raising difficulty, yielding a step reward of $0.0896$.}}{103}{figure.caption.138}\protected@file@percent }
\newlabel{fig:replay_step3}{{A.1}{103}{Episode 2, Step 3, cumulative reward $0.24$, with student state Knowledge $0.50$, Engagement $0.61$, Frustration $0.11$, Confusion $0.09$, Boredom $0.06$. The policy selected \textbf {scaffold}, a flow-consistent choice that structures a high-engagement learner without raising difficulty, yielding a step reward of $0.0896$}{figure.caption.138}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.2}{\ignorespaces Episode 2, Step 4, cumulative reward $0.33$, with student state Knowledge $0.54$, Engagement $0.58$, Frustration $0.13$, Confusion $0.17$, Boredom $0.11$. The policy selected \textbf  {harder problem} as the learner's knowledge level increased to approximately $0.54$, resulting in a rise in confusion to $0.17$ following the increase in task difficulty, with a step reward of $0.0845$.}}{103}{figure.caption.139}\protected@file@percent }
\newlabel{fig:replay_step4}{{A.2}{103}{Episode 2, Step 4, cumulative reward $0.33$, with student state Knowledge $0.54$, Engagement $0.58$, Frustration $0.13$, Confusion $0.17$, Boredom $0.11$. The policy selected \textbf {harder problem} as the learner's knowledge level increased to approximately $0.54$, resulting in a rise in confusion to $0.17$ following the increase in task difficulty, with a step reward of $0.0845$}{figure.caption.139}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.3}{\ignorespaces Episode 2, Step 5, cumulative reward $0.38$, with student state Knowledge $0.52$, Engagement $0.60$, Frustration $0.13$, Confusion $0.13$, Boredom $0.10$. In response to the prior confusion rise, the policy selected \textbf  {explanation}, which lowered confusion to $0.13$ while engagement stayed high, yielding a step reward of $0.0551$.}}{104}{figure.caption.140}\protected@file@percent }
\newlabel{fig:replay_step5}{{A.3}{104}{Episode 2, Step 5, cumulative reward $0.38$, with student state Knowledge $0.52$, Engagement $0.60$, Frustration $0.13$, Confusion $0.13$, Boredom $0.10$. In response to the prior confusion rise, the policy selected \textbf {explanation}, which lowered confusion to $0.13$ while engagement stayed high, yielding a step reward of $0.0551$}{figure.caption.140}{}}
