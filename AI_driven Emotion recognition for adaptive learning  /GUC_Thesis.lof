\contentsline {figure}{\numberline {5.5}{\ignorespaces Per-label accuracy of \textbf {[OURS]}. The dashed line at $0.5$ marks the balanced-binary chance baseline.}}{81}{figure.caption.116}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Training loss and validation Macro F1 across epochs for \textbf {[OURS]}. The dashed line at epoch $1$ marks the early-stopping checkpoint.}}{82}{figure.caption.117}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Per-label F1 of the SVM baselines and \textbf {[OURS]}. The SVM baselines have non-zero F1 only on engagement.}}{85}{figure.caption.122}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Macro F1 progression through the ResNet50+BiLSTM ablation. The WRS+WBCE double-correction failure is highlighted in coral; \textbf {[OURS]} is the highest entry.}}{86}{figure.caption.123}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces Training-time reward trajectory of the DQN policy on Configuration~B with the eval-time reward of the rule and random baselines as horizontal references. The confidence band is $\pm 1.96$ standard errors across four seeds. The rule and random baselines do not undergo training; their lines are the average evaluation reward of fixed policies and are shown as horizontal references so that the DQN trajectory can be read against a stable benchmark.}}{89}{figure.caption.127}%
\contentsline {figure}{\numberline {5.10}{\ignorespaces Normalised learning gain by policy and configuration with $95\%$ bootstrap confidence intervals across ten seeds.}}{90}{figure.caption.128}%
\contentsline {figure}{\numberline {5.11}{\ignorespaces Episode success rate by policy and configuration with $95\%$ bootstrap confidence intervals across ten seeds.}}{90}{figure.caption.129}%
\contentsline {figure}{\numberline {5.12}{\ignorespaces Per-seed normalised learning gain for both configurations. Violin shapes show the empirical distribution; the inner box reports the median and interquartile range.}}{91}{figure.caption.130}%
\contentsline {figure}{\numberline {5.13}{\ignorespaces Affect-conditioned action distribution of the trained DQN policy on Configuration~B. Each row sums to one before omission; entries below 0.05 are hidden.}}{94}{figure.caption.135}%
\contentsline {figure}{\numberline {5.14}{\ignorespaces Integrated FER-RL pipeline. The perception layer converts a face-aligned window into a four-channel affect vector; the adapter assembles the RL state; the DQN policy emits a pedagogical action that updates the learner state at the next interaction step.}}{95}{figure.caption.136}%
