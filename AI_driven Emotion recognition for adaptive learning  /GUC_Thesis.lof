\contentsline {figure}{\numberline {2.1}{\ignorespaces Illustration of a basic neural network architecture with input, hidden, and output layers.}}{8}{figure.caption.13}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Basic architecture of a Convolutional Neural Network showing convolution, pooling, and classification stages. Adapted from \cite {alsaleh2023efficientcnn}.}}{9}{figure.caption.14}%
